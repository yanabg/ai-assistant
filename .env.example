# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# All settings are read exclusively by chatapp.config.Config.

# Identifier of the model the AI client should target.
CHATAPP_MODEL_NAME=gpt-4o-mini

# Base URL of the OpenAI-compatible endpoint.
CHATAPP_API_BASE_URL=https://api.openai.com/v1

# Secret API token used to authenticate with the endpoint. (required)
CHATAPP_API_KEY=sk-replace-me

# Directory under which all hierarchies and entries are stored.
CHATAPP_DATA_DIR=./data
